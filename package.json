{
  "name": "translate-research",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "NODE_ENV=development electron .",
    "dev:full": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.yourname.translateresearch",
    "productName": "TranslateResearch",
    "win": {
      "target": "portable"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/portable.flag",
        "to": "portable.flag"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "electron-store": "^11.0.2",
    "keytar": "^7.9.0",
    "openai": "^6.38.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.0.0",
    "wait-on": "^9.0.10"
  }
}
